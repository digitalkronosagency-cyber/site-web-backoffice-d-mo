# ============================================================
# Base de données — PostgreSQL serverless (Neon ou Vercel Postgres)
# ============================================================
# URL de connexion "pooled" (utilisée par l'application au runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
# URL de connexion directe, non-poolée (utilisée par Prisma pour les migrations)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================================
# Authentification admin (magic link, sans mot de passe)
# ============================================================
# Email autorisé à se connecter au backoffice
ADMIN_EMAIL="admin@electricitedumont.fr"
# Secret utilisé pour signer les sessions JWT (générer avec: openssl rand -base64 32)
AUTH_SECRET=""

# ============================================================
# Application
# ============================================================
# URL publique de base du site (utilisée pour générer les liens dans les emails)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================================
# Resend — envoi d'emails transactionnels
# ============================================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Électricité Dumont <contact@votre-domaine.fr>"

# ============================================================
# Vercel Blob — stockage des photos et PDF
# ============================================================
BLOB_READ_WRITE_TOKEN=""

# ============================================================
# Vercel Cron — sécurisation de la route de relance automatique
# ============================================================
# Générer avec: openssl rand -hex 24
CRON_SECRET=""
